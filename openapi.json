{
  "openapi": "3.0.3",
  "info": {
    "title": "Service B - Item Provider API",
    "description": "API Contract (Schnittstellenvertrag) for Service B in Modul 321 (Distributed Systems). Defines the contract between Service B (Data Provider) and consumer services like Service A.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "Root greeting",
        "description": "Returns a welcome greeting from Service B",
        "operationId": "getRoot",
        "responses": {
          "200": {
            "description": "Greeting message",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["message"],
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Hello World from Service B"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health check",
        "description": "Returns the operational health status of Service B",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Service is healthy and ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/items": {
      "get": {
        "summary": "List all items",
        "description": "Returns the complete list of items provided by Service B",
        "operationId": "getItems",
        "responses": {
          "200": {
            "description": "List of items retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Item"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new item",
        "description": "Adds a new item according to the contract schema and assigns a generated ID",
        "operationId": "createItem",
        "requestBody": {
          "description": "Item data to create",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ItemInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Item created successfully",
            "headers": {
              "Location": {
                "description": "URL of the created item resource",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            }
          },
          "400": {
            "description": "Validation error or invalid request payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/items/{id}": {
      "get": {
        "summary": "Get item by ID",
        "description": "Retrieves details of a single item by its numeric ID",
        "operationId": "getItemById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Numeric ID of the item",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Item details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID format",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Item not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Update an item",
        "description": "Updates an existing item's name and price",
        "operationId": "updateItem",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Numeric ID of the item to update",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "description": "Updated item data",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ItemInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Item updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            }
          },
          "400": {
            "description": "Validation error or invalid request payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Item not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete an item",
        "description": "Deletes an item by its numeric ID",
        "operationId": "deleteItem",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Numeric ID of the item to delete",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Item deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["message"],
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Item deleted successfully"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Item not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "Get API contract as OpenAPI JSON",
        "description": "Serves the OpenAPI 3.0 specification contract in JSON format",
        "operationId": "getOpenApiSpec",
        "responses": {
          "200": {
            "description": "OpenAPI specification document",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/docs": {
      "get": {
        "summary": "Interactive Swagger UI documentation",
        "description": "Displays interactive API contract documentation via Swagger UI",
        "operationId": "getDocs",
        "responses": {
          "200": {
            "description": "Swagger UI HTML page",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Item": {
        "type": "object",
        "description": "Item data object as provided by Service B",
        "required": ["id", "name", "price"],
        "properties": {
          "id": {
            "type": "integer",
            "description": "Unique identifier",
            "example": 1
          },
          "name": {
            "type": "string",
            "description": "Product or item name",
            "example": "Laptop"
          },
          "price": {
            "type": "number",
            "format": "double",
            "description": "Price in CHF",
            "example": 1299.90
          }
        }
      },
      "ItemInput": {
        "type": "object",
        "description": "Payload required to create or update an item",
        "required": ["name", "price"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Non-empty product name",
            "example": "Keyboard"
          },
          "price": {
            "type": "number",
            "minimum": 0.01,
            "description": "Price in CHF (must be greater than 0)",
            "example": 89.50
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "description": "Service health check response",
        "required": ["status", "service"],
        "properties": {
          "status": {
            "type": "string",
            "description": "Operational status",
            "example": "UP"
          },
          "service": {
            "type": "string",
            "description": "Service identifier",
            "example": "service-b"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "description": "Standardized error response according to API contract",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "string",
            "description": "Short error title or category",
            "example": "Validation Error"
          },
          "detail": {
            "type": "string",
            "description": "Detailed explanation of the error",
            "example": "Field 'name' is required and must be a non-empty string."
          }
        }
      }
    }
  }
}
